@startuml model_l9_composition_route_members
' Generated for the slides.
!theme mono
skinparam backgroundColor white
skinparam defaultFontName "Fira Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 75
skinparam ArrowThickness 1.5
hide circle
hide empty members


left to right direction

class Route #back:FFF3E0;line:E65100;text:000000 {
  - waypoints_ : vector<Position>
  + add(Position) : void
  + length() : double
}
class Position <<struct>> #back:FFF3E0;line:E65100;text:000000 {
  + x : double
  + y : double
}

Route "<color:#000000>1</color>" *-[#E65100,thickness=2]---- "<color:#000000>-waypoints_  0..*</color>" Position : <color:#000000>has</color>
@enduml
