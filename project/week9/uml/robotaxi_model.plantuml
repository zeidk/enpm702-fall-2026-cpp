@startuml model_full_members
' Generated by robotaxi_model.py: edit the generator, not this file.
!theme mono
skinparam backgroundColor white
skinparam defaultFontName "Fira Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 45
skinparam ArrowThickness 1.5
hide circle
hide empty members


left to right direction

class Fleet {
  - vehicles_ : vector<shared_ptr<Vehicle>>
  + add(shared_ptr<Vehicle>) : void
  + remove(int) : bool
  + size() : size_t
}
class Passenger {
  - name_ : string
  - ride_ : weak_ptr<Vehicle>
  + board(shared_ptr<Vehicle>) : void
  + leave() : void
}
abstract class Vehicle {
  - id_ : int
  - {static} next_id_ : int
  - max_speed_ : double
  - speed_ : double
  - sensors_ : vector<unique_ptr<Sensor>>
  + Vehicle(double)
  + Vehicle(double, double)
  + get_id() : int
  + get_max_speed() : double
  + get_speed() : double
  + set_speed(double) : void
  + add_sensor(SensorType, double) : int
  + sensor_count() : size_t
  + {abstract} drive(const Route&) : void
  + {static} next_id() : int
}
class Sensor {
  - id_ : int
  - type_ : SensorType
  - range_ : double
  + Sensor(int, SensorType = lidar, double = 100.0)
  + get_id() : int
  + get_type() : SensorType
  + get_range() : double
}
enum SensorType <<enumeration>> {
  lidar
  camera
  radar
}
class Route {
  - waypoints_ : vector<Position>
  + add(Position) : void
  + length() : double
}
class Position <<struct>> {
  + x : double
  + y : double
}
class RoboTaxi <<final>> {
  + drive(const Route&) : void
}
class Taxi <<final>> {
  - driver_name_ : string
  + drive(const Route&) : void
}

Fleet "1" o-- "0..*" Vehicle : holds
Passenger "0..*" --> "0..1" Vehicle : rides
Vehicle "1" *-- "0..*" Sensor : owns
Vehicle ..> Route : uses
Route "1" *-- "0..*" Position : has
Sensor ..> SensorType
Vehicle <|-- RoboTaxi
Vehicle <|-- Taxi
@enduml
