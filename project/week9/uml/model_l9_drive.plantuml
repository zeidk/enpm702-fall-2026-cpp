@startuml model_l9_drive
' Generated for the slides.
!theme mono
skinparam backgroundColor white
skinparam defaultFontName "Fira Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 75
skinparam ArrowThickness 1.5

hide empty members


left to right direction

class Vehicle #back:FFF3E0;line:E65100;text:000000 {
  + drive(const Route&) : void
}
class RoboTaxi #back:FFF3E0;line:E65100;text:000000 {
  + drive(const Route&) : void
}
class Taxi #back:FFF3E0;line:E65100;text:000000 {
  + drive(const Route&) : void
}

Vehicle <|-[#E65100,thickness=2]- RoboTaxi
Vehicle <|-[#E65100,thickness=2]- Taxi
@enduml
