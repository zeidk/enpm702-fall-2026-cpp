@startuml multiple_inheritance
' Generated for the slides.
!theme mono
skinparam backgroundColor white
skinparam defaultFontName "Fira Sans"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowThickness 1.5
hide circle
hide empty attributes
class Lion {
  - leg_count_ : int
  + run() : void
}
class Human {
  + speak() : void
}
class Bird {
  - wing_span_ : double
  + can_fly() : bool
}
class Sphinx {
  - riddle_ : string
  + ask_riddle() : void
}
Lion <|-- Sphinx
Human <|-- Sphinx
Bird <|-- Sphinx
@enduml
